# Dedicated ml_forecast role only. Never use DATABASE_URL or RLS_DATABASE_URL.
ML_DATABASE_URL=postgresql://ml_forecast.PROJECT_REF:PASSWORD@HOST:6543/postgres

# The nightly job is tenant-scoped. Scheduling supplies one tenant UUID per
# invocation. The manual queue worker claims the tenant from each queued run
# and does not use this value.
ML_TENANT_ID=00000000-0000-0000-0000-000000000000
